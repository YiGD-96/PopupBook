# Copy to .env.local (or set the same names in Vercel › Settings › Environment Variables).
# GA4 measurement ID. When set, gtag.js loads after the intro and the book sends its events (see src/analytics.ts).
VITE_GA_ID=G-XXXXXXXXXX
# The deployed address, without a trailing slash. Makes canonical, Open Graph, JSON-LD and sitemap URLs absolute.
VITE_SITE_URL=https://your-project.vercel.app
